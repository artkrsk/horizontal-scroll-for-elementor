{
  "name": "@arts/horizontal-scroll",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "dev:plugin": "arts-wp dev",
    "build": "arts-wp build",
    "release": "arts-wp release",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:library": "node scripts/build-library.mjs"
  },
  "devDependencies": {
    "@artemsemkin/elementor-types": "^2.0.0",
    "@arts/wp-plugin-tooling": "github:artkrsk/wp-plugin-tooling",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@wordpress/env": "11.16.0",
    "esbuild": "^0.28.2",
    "fallow": "^3.15.0",
    "happy-dom": "^20.11.2",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "exports": {
    ".": {
      "arts-source": "./src/ts/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./contract": {
      "arts-source": "./src/ts/contract.ts",
      "types": "./dist/types/contract.d.ts",
      "import": "./dist/esm/contract.js",
      "default": "./dist/esm/contract.js"
    },
    "./package.json": "./package.json",
    "./src/ts/*": "./src/ts/*",
    "./src/styles/*": "./src/styles/*",
    "./styles.scss": "./src/styles/index.scss",
    "./styles.css": "./dist/esm/styles.css"
  },
  "files": [
    "dist/esm",
    "dist/types",
    "src/ts",
    "src/styles"
  ]
}
