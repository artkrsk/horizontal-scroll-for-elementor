includes:
	- vendor/arts/wp-plugin-standards/phpstan/base.neon

parameters:
	paths:
		- src/php
		- tests/php
	bootstrapFiles:
		- vendor/autoload.php
		- phpstan-bootstrap.php
	scanFiles:
		- vendor/arts/elementor-stubs/elementor-stubs.php
	scanDirectories:
		- vendor/wp-phpunit/wp-phpunit/includes
