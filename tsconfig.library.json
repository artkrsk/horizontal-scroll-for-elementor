{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": false,
    "types": [],
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src/ts",
    "outDir": "dist/types"
  },
  "files": ["src/ts/index.ts", "src/ts/contract.ts"]
}
